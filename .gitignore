# =========================================================
#  GitHub에 올리지 않을 것들 (.gitignore)
#  - GitHub는 파일 1개 100MB 제한 + 개인정보(회원영상) 보호
#  - 무거운 자료 / 빌드 결과물 / 비밀키는 전부 제외
# =========================================================

# ===== 의존성 (절대 올리면 안 됨, 수만 개 파일) =====
**/node_modules/

# ===== Next.js 빌드 결과물 =====
**/.next/
**/out/
**/build/
**/dist/

# ===== 대용량 개인 자료 폴더 (회원 영상·자료집 등 수십 GB) =====
# 대괄호는 gitignore에서 특수문자라 \ 로 이스케이프함
\[프로젝트 이외 자료들\]/
Collage/

# ===== 대용량 파일 형식 (어디에 있든 제외) =====
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.zip
*.7z
*.rar
*.psd
*.ai
*.iso

# ===== 환경변수 / 비밀키 =====
**/.env
**/.env.local
**/.env*.local

# ===== 로그 / 잡파일 =====
**/dev.log
.claude/scheduled_tasks.lock
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# ===== OS / 에디터 잡파일 =====
.DS_Store
Thumbs.db
**/.vscode/
*.tsbuildinfo
next-env.d.ts
